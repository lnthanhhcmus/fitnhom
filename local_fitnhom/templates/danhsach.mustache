{{!
    @template local_fitnhom/danhsach

    Danh sách bài nộp chưa khai: mỗi dòng "Em làm một mình" (lưu ngay) và "Bài nhóm…" (trang khai của bài).

    Example context (json):
    {
        "sesskey": "abc", "ve": "/my/", "urlkhai": "/local/fitnhom/khai.php",
        "dong": [{"submissionid": 5, "bai": "Đồ án 1", "mon": "CSC10001", "luc": "25/10/26, 20:15",
            "urlnhom": "/local/fitnhom/khai.php?id=5", "urlbai": "/mod/assign/view.php?id=9"}]
    }
}}
<p class="mb-2">{{#str}} hopnoi_giaithich, local_fitnhom {{/str}}</p>
<ul class="list-group local-fitnhom-ds">
    {{#dong}}
    <li class="list-group-item d-flex flex-wrap align-items-center" data-submissionid="{{submissionid}}">
        <div class="flex-grow-1 mr-2 me-2">
            <a href="{{urlbai}}"><strong>{{bai}}</strong></a>
            <div class="small text-muted">{{mon}} · {{#str}} danop, local_fitnhom, {{luc}} {{/str}}</div>
        </div>
        <form method="post" action="{{urlkhai}}" class="d-inline mr-1 me-1">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="action" value="mot">
            <input type="hidden" name="id" value="{{submissionid}}">
            <input type="hidden" name="ve" value="{{ve}}">
            <button type="submit" class="btn btn-sm btn-outline-secondary">{{#str}} motminh_nut, local_fitnhom {{/str}}</button>
        </form>
        <a class="btn btn-sm btn-primary" href="{{urlnhom}}">{{#str}} nhom_nut, local_fitnhom {{/str}}</a>
    </li>
    {{/dong}}
</ul>
